[Unit]
Description=Gymboard, the only thing this Pi does
After=network-online.target seatd.service
Wants=network-online.target
Requires=seatd.service

[Service]
Type=simple
User=jkevin
Environment=HOME=/home/jkevin
# Its own runtime dir, so the board does not depend on a login session
# existing. systemd creates and cleans this up.
RuntimeDirectory=gymboard
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/gymboard
# WLR_LIBINPUT_NO_DEVICES is deliberately NOT set. It was, on the theory
# that a board with dead USB has no input devices, but the HDMI port
# registers two of its own (CEC, and jack detect) so wlroots starts fine
# without it. With it set, wlroots skips libinput entirely and draws its
# default cursor in the middle of the screen, where it sits forever
# because nothing exists that could move it. The page's `cursor: none`
# cannot help: that cursor belongs to the compositor, not the page.
ExecStart=/usr/local/bin/gymboard-kiosk
Restart=always
RestartSec=5
# A board nobody is standing at has to survive its own browser dying.
StartLimitBurst=0

[Install]
WantedBy=multi-user.target
